generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Foundations: org structure, auth/RBAC, audit log, documents, break-glass
// confidential-data grants. Reused unchanged from the prior TalentFlow build
// (BUILD_PLAN.md Sec 2). Project domain models are below.
// ---------------------------------------------------------------------------

enum Role {
  AI_ANALYST
  DEVELOPER
  BUSINESS_OWNER
  AI_TEAM_LEAD
  MANAGEMENT
}

model BusinessUnit {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]
  projects    Project[]

  @@map("business_units")
}

model Department {
  id             String       @id @default(cuid())
  name           String
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  projects       Project[]

  @@unique([businessUnitId, name])
  @@map("departments")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String
  role           Role
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions           Session[]
  auditLogs          AuditLog[]
  confidentialGrants ConfidentialDataGrant[] @relation("GrantRecipient")
  grantsIssued       ConfidentialDataGrant[] @relation("GrantIssuer")

  // Project domain relations.
  projectsAsOwner       Project[]                @relation("ProjectOwner")
  projectsAsAnalyst     Project[]                @relation("ProjectAnalyst")
  projectsAsDeveloper   Project[]                @relation("ProjectDeveloper")
  stageHistoryActions   ProjectStageHistory[]    @relation("StageHistoryActor")
  checklistItemsChecked StageGateChecklistItem[] @relation("ChecklistCheckedBy")
  milestonesOwned       Milestone[]              @relation("MilestoneOwner")
  tasksOwned            ProjectTask[]            @relation("TaskOwner")
  blockersRaised        Blocker[]                @relation("BlockerRaisedBy")
  blockersResolved      Blocker[]                @relation("BlockerResolvedBy")
  scopeChangesRequested ScopeChange[]            @relation("ScopeChangeRequestedBy")
  delayReasonsRecorded  DelayReason[]            @relation("DelayReasonRecordedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// Break-glass elevation grant: confidential fields are hidden by default
// even from elevated roles. Every grant + access under it is written to
// AuditLog.
model ConfidentialDataGrant {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("GrantRecipient", fields: [userId], references: [id])
  grantedById String
  grantedBy   User      @relation("GrantIssuer", fields: [grantedById], references: [id])
  reason      String
  scope       String // e.g. "project:{id}" or "global" — kept as a string tag for MVP
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("confidential_data_grants")
}

// Append-only. No UPDATE/DELETE application-level path is exposed —
// enforced in lib/audit.ts, and DB role privileges should mirror this
// in production.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum DocumentOwnerType {
  PROJECT
}

// Never stores the file itself — storageKey points at the S3-compatible
// object store. Upload/download both go through presigned URLs.
model Document {
  id           String            @id @default(cuid())
  ownerType    DocumentOwnerType
  ownerId      String
  storageKey   String            @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime          @default(now())

  @@index([ownerType, ownerId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Project domain (BUILD_PLAN.md Sec 3-4): one Project per AI/software
// initiative, tracked through a 10-stage gated pipeline from idea to
// deployment. "One Project Owner · One Current Stage · One Next Milestone ·
// One Next Action · One Expected Delivery Date" (assignment Sec 10).
// ---------------------------------------------------------------------------

// IDEA -> DISCOVERY -> REQUIREMENTS_DESIGN -> APPROVAL -> DEVELOPMENT ->
// INTERNAL_TESTING -> BUSINESS_TESTING_UAT -> DEPLOYMENT -> STABILIZATION ->
// COMPLETED (assignment Sec 3). Each forward transition is gated: all
// required=true StageGateChecklistItem rows for the *current* stage must be
// checked before the transition API writes ProjectStageHistory and advances
// currentStage (lib/project-stages.ts).
enum ProjectStage {
  IDEA
  DISCOVERY
  REQUIREMENTS_DESIGN
  APPROVAL
  DEVELOPMENT
  INTERNAL_TESTING
  BUSINESS_TESTING_UAT
  DEPLOYMENT
  STABILIZATION
  COMPLETED
}

// Computed server-side (lib/project-health.ts), never set directly by a
// user: ON_TRACK (default) -> AT_RISK (a milestone due within N days) ->
// DELAYED (a milestone is overdue) -> BLOCKED (an active unresolved
// Blocker exists, which takes priority over milestone-derived status).
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  DELAYED
  BLOCKED
}

model Project {
  id                    String        @id @default(cuid())
  name                  String
  businessUnitId        String
  businessUnit          BusinessUnit  @relation(fields: [businessUnitId], references: [id])
  departmentId          String
  department            Department    @relation(fields: [departmentId], references: [id])
  businessProblem       String
  expectedOutcome       String
  ownerId               String
  owner                 User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  analystId             String?
  analyst               User?         @relation("ProjectAnalyst", fields: [analystId], references: [id])
  developerId           String?
  developer             User?         @relation("ProjectDeveloper", fields: [developerId], references: [id])
  currentStage          ProjectStage  @default(IDEA)
  health                ProjectHealth @default(ON_TRACK)
  expectedDeliveryDate  DateTime
  version               Int           @default(1)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  stageHistory        ProjectStageHistory[]
  gateChecklistItems  StageGateChecklistItem[]
  milestones          Milestone[]
  tasks               ProjectTask[]
  blockers            Blocker[]
  scopeChanges        ScopeChange[]
  delayReasons        DelayReason[]

  @@index([businessUnitId, departmentId])
  @@index([currentStage])
  @@index([health])
  @@index([ownerId])
  @@map("projects")
}

// Append-only. Every stage change — forced or otherwise — creates a
// permanent history record with an evidence snapshot of the gate checklist
// state at the moment of transition.
model ProjectStageHistory {
  id                String        @id @default(cuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id])
  fromStage         ProjectStage?
  toStage           ProjectStage
  actorId           String
  actor             User          @relation("StageHistoryActor", fields: [actorId], references: [id])
  evidenceSnapshot  Json?
  notes             String?
  changedAt         DateTime      @default(now())

  @@index([projectId])
  @@map("project_stage_history")
}

// Exit criteria checklist, seeded per stage from the assignment's Sec 5
// gate list (lib/checklist-engine.ts). A project's transition out of its
// *current* stage is blocked while any required=true item for that stage
// is unchecked.
model StageGateChecklistItem {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  stage         ProjectStage
  label         String
  required      Boolean       @default(true)
  checked       Boolean       @default(false)
  checkedById   String?
  checkedBy     User?         @relation("ChecklistCheckedBy", fields: [checkedById], references: [id])
  checkedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId, stage])
  @@map("stage_gate_checklist_items")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// "One Next Milestone" per project (design principle) — drives health
// computation: overdue (dueDate < now, status != DONE) -> DELAYED,
// due within N days -> AT_RISK.
model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  name        String
  ownerId     String
  owner       User            @relation("MilestoneOwner", fields: [ownerId], references: [id])
  dueDate     DateTime
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tasks       ProjectTask[]
  delayReasons DelayReason[]

  @@index([projectId])
  @@index([ownerId, dueDate])
  @@index([status])
  @@map("milestones")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

// "One Next Action" per project (design principle). Optionally tied to a
// Milestone for grouping, but not required — an ad hoc action doesn't need
// a milestone to exist.
model ProjectTask {
  id                String      @id @default(cuid())
  projectId         String
  project           Project     @relation(fields: [projectId], references: [id])
  action            String
  ownerId           String
  owner             User        @relation("TaskOwner", fields: [ownerId], references: [id])
  deadline          DateTime?
  status            TaskStatus  @default(PENDING)
  relatedMilestoneId String?
  relatedMilestone  Milestone?  @relation(fields: [relatedMilestoneId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([projectId])
  @@index([ownerId, deadline])
  @@index([status])
  @@map("project_tasks")
}

// An active (unresolved) Blocker forces Project.health to BLOCKED,
// overriding the milestone-derived status — resolving it re-triggers
// health recomputation from the remaining milestone state.
model Blocker {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  description     String
  impact          String
  requiredAction  String?
  raisedById      String
  raisedBy        User      @relation("BlockerRaisedBy", fields: [raisedById], references: [id])
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?     @relation("BlockerResolvedBy", fields: [resolvedById], references: [id])
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([projectId, resolvedAt])
  @@map("blockers")
}

// Records a scope change request and its delivery-date impact. Append-only
// log, not itself a workflow — recording one does not automatically shift
// Project.expectedDeliveryDate; that remains an explicit edit.
model ScopeChange {
  id                           String    @id @default(cuid())
  projectId                    String
  project                      Project   @relation(fields: [projectId], references: [id])
  requestedById                String
  requestedBy                  User      @relation("ScopeChangeRequestedBy", fields: [requestedById], references: [id])
  reason                       String
  deliveryImpact               String?
  previousExpectedDeliveryDate DateTime?
  newExpectedDeliveryDate      DateTime?
  createdAt                    DateTime  @default(now())

  @@index([projectId])
  @@map("scope_changes")
}

// Fixed taxonomy (assignment Sec 8). Capturing one of these is mandatory
// the moment a Project or Milestone crosses into DELAYED health — enforced
// in lib/project-health.ts, not a DB constraint.
enum DelayReasonCategory {
  REQUIREMENTS_NOT_FINALIZED
  RESOURCE_UNAVAILABLE
  WAITING_FOR_BUSINESS_FEEDBACK
  SCOPE_CHANGE
  DATA_UNAVAILABLE
  TESTING_ISSUE
  DEVELOPMENT_ISSUE
  APPROVAL_PENDING
  INTEGRATION_DEPENDENCY
  OTHER
}

model DelayReason {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id])
  milestoneId   String?
  milestone     Milestone?          @relation(fields: [milestoneId], references: [id])
  category      DelayReasonCategory
  note          String?
  recordedById  String
  recordedBy    User                @relation("DelayReasonRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime            @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@map("delay_reasons")
}
