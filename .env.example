DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
S3_REGION="<project-region>"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
S3_BUCKET="talentflow-documents"
S3_FORCE_PATH_STYLE="true"

SESSION_SECRET="change-me-in-production"

FIELD_ENCRYPTION_KEY="change-me-32-byte-base64-key-in-production"

AGENT_MONITOR_SECRET="change-me-in-production"

# LLM providers tried in order by lib/llm-client.ts: gemini-3.1-flash-lite,
# then DeepSeek. Each tier is skipped if its API key is unset; if both are
# unset, generateFlagNarration falls back straight to RULE_FALLBACK, and
# the assistant route (app/api/v1/assistant) throws until at least one is set.
GEMINI_API_KEY="AIza..."

# DeepSeek tier (OpenAI-compatible endpoint). BASE_URL and MODEL are
# optional and default to the values below.
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"

# Immediate per-flag email alerts (agent-monitor route) — sent to active
# MANAGEMENT/AI_TEAM_LEAD users whenever a new AgentFlag is created.
# If RESEND_API_KEY is unset, alert emails are skipped (monitor still runs).
RESEND_API_KEY="re_..."
ALERT_EMAIL_FROM="PMO Agent <alerts@your-verified-domain.com>"
APP_BASE_URL="http://localhost:3000"
